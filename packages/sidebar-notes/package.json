{
  "name": "dsh-plugin-sidebar-notes",
  "version": "1.3.0",
  "type": "module",
  "description": "Sidebar Notes: a note-taking panel in the DeepSeek Harness Web UI sidebar; notes persist to local Markdown files.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
