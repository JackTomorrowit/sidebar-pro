{
  "name": "dsh-plugin-sidebar-todo",
  "version": "1.3.16",
  "type": "module",
  "description": "Sidebar Todo: a todo panel in the DeepSeek Harness Web UI sidebar with tasks, projects problem logs, monthly goals and a week (period) view.",
  "license": "MIT",
  "author": "JackTomorrowit",
  "repository": {
    "type": "git",
    "url": "https://github.com/JackTomorrowit/sidebar-pro.git",
    "directory": "packages/sidebar-todo"
  },
  "homepage": "https://github.com/JackTomorrowit/sidebar-pro/tree/main/packages/sidebar-todo",
  "bugs": {
    "url": "https://github.com/JackTomorrowit/sidebar-pro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./preset-restrict": "./preset-restrict.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "preset-restrict.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
